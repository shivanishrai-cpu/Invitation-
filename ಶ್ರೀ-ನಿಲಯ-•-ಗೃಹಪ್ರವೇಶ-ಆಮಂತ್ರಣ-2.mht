@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Noto+Serif+Kannada:wght@400;600;700;800&family=Tiro+Kannada&family=Noto+Sans+Kannada:wght@400;600&display=swap");

:root { --maroon: #8e2a2a; --blue: #2c3a8c; --pink: #a3205f; --green: #2f5a34; --gold: #b8893a; --cream: #f4efdc; --ink: #3b2a20; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; min-height: 100vh; color: var(--maroon); font-family: "Noto Serif Kannada", "Tiro Kannada", serif; background: radial-gradient(at 50% -10%, rgb(77, 122, 74) 0px, transparent 60%) rgb(27, 53, 36); overflow-x: hidden; }

button, a { cursor: pointer; -webkit-tap-highlight-color: transparent; }

button { font: inherit; }

:focus-visible { outline: rgb(224, 178, 74) solid 3px; outline-offset: 3px; }

main { max-width: 520px; margin: auto; padding: 26px 14px 36px; }

.topline { text-align: center; color: rgb(233, 215, 160); font: 600 10px "Noto Sans Kannada", sans-serif; letter-spacing: 4px; margin: 0px 0px 16px; }

.card { position: relative; background: var(--cream); padding: 12px; box-shadow: rgba(0, 0, 0, 0.533) 0px 30px 80px, rgb(212, 180, 106) 0px 0px 0px 1px; overflow: hidden; isolation: isolate; opacity: 0; transform: translateY(20px); animation: 1s ease 0.1s 1 normal forwards running arrive; }

.card.paused { animation-play-state: paused; }

@keyframes arrive { 
  100% { opacity: 1; transform: none; }
}

.bg { position: absolute; inset: 0px; z-index: -2; background: linear-gradient(45deg, transparent 48.8%, rgb(201, 185, 136) 49%, rgb(201, 185, 136) 51%, transparent 51.2%) 0px 0px / 46px 46px, linear-gradient(-45deg, transparent 48.8%, rgb(201, 185, 136) 49%, rgb(201, 185, 136) 51%, transparent 51.2%) 0px 0px / 46px 46px, radial-gradient(circle at 23px 23px, rgba(255, 255, 255, 0.565) 0px, rgba(255, 255, 255, 0.565) 7px, transparent 8px) 0px 0px / 46px 46px, rgb(234, 229, 207); }

.bg::after { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 50% 45%, rgba(255, 247, 230, 0.9) 0px, rgba(255, 244, 220, 0.85) 45%, rgba(243, 234, 208, 0.667) 100%); }

.border { position: absolute; inset: 7px; border: 2px solid var(--green); z-index: 1; pointer-events: none; }

.border::before { content: ""; position: absolute; inset: 4px; border: 1px solid var(--gold); }

.border::after { content: ""; position: absolute; inset: 9px; border: 5px double rgb(138, 160, 102); opacity: 0.55; }

.pattern { position: absolute; left: 14px; right: 14px; height: 11px; z-index: 1; background: repeating-linear-gradient(90deg,var(--green) 0 8px,transparent 8px 12px,var(--gold) 12px 14px,transparent 14px 18px); opacity: 0.75; }

.pattern.t { top: 14px; }

.pattern.b { bottom: 14px; }

.garland { position: absolute; top: 0px; bottom: 0px; width: 18px; z-index: 3; background: radial-gradient(circle, rgb(224, 124, 0) 0px, rgb(224, 124, 0) 3.5px, rgb(255, 184, 28) 4.5px, rgb(255, 184, 28) 7px, transparent 8px) 0px 0px / 18px 20px; filter: drop-shadow(rgba(0, 0, 0, 0.267) 0px 1px 1px); animation: 5s ease-in-out 0s infinite alternate none running sway; }

.garland.l { left: 1px; }

.garland.r { right: 1px; animation-delay: -2s; }

@keyframes sway { 
  100% { transform: translateY(3px); }
}

.leaf { position: absolute; top: 36px; width: 150px; height: 230px; z-index: 2; transform-origin: center top; animation: 6s ease-in-out 0s infinite alternate none running leafsway; }

.leaf.l { left: -14px; }

.leaf.r { right: -14px; transform: scaleX(-1); animation-name: leafsway2; }

@keyframes leafsway { 
  100% { transform: rotate(2.5deg); }
}

@keyframes leafsway2 { 
  0% { transform: scaleX(-1) rotate(0deg); }
  100% { transform: scaleX(-1) rotate(2.5deg); }
}

.content { position: relative; z-index: 4; padding: 34px 30px 26px; text-align: center; }

.inv { font-size: 12.5px; font-weight: 700; line-height: 2; margin: 0px 0px 6px; color: var(--maroon); }

.inv p { margin: 0px; }

.row { display: flex; justify-content: flex-end; margin: 12px 0px 0px; }

.place { text-align: right; font-weight: 700; color: var(--maroon); }

.place .pl { font-size: 13px; }

.place .dt { font-size: 19px; letter-spacing: 0.5px; }

.dear { text-align: left; font-size: 17px; font-weight: 700; margin: -6px 0px 8px; color: var(--maroon); }

.panch { font-size: 13.5px; line-height: 2.15; font-weight: 700; color: var(--blue); margin: 0px auto 6px; max-width: 330px; }

.panch b { color: var(--maroon); font-weight: 800; }

.house-intro { font-size: 14px; line-height: 2; font-weight: 700; color: var(--blue); margin: 0px; }

.name { font-family: "Tiro Kannada", "Noto Serif Kannada", serif; font-size: clamp(46px, 13vw, 60px); line-height: 1.5; color: var(--maroon); margin: 4px 0px 0px; font-weight: 400; background: linear-gradient(rgb(162, 45, 45), rgb(111, 23, 23)) text; -webkit-text-fill-color: transparent; text-shadow: none; filter: drop-shadow(rgba(255, 255, 255, 0.533) 0px 2px 0px); }

.orn { width: 180px; height: 16px; margin: 0px auto 6px; color: var(--gold); }

.grihapravesha { font-size: 21px; font-weight: 800; color: var(--blue); margin: 6px 0px 0px; line-height: 1.7; }

.satya { font-size: 17.5px; font-weight: 800; color: var(--blue); margin: 0px; line-height: 1.9; }

.guru { font-size: 14.5px; font-weight: 700; color: var(--blue); margin: 2px 0px 14px; line-height: 2; }

.appeal { font-size: 15px; line-height: 2.15; font-weight: 700; color: var(--maroon); margin: 0px 0px 14px; }

.appeal em { font-style: normal; color: var(--blue); }

.cd { display: flex; gap: 6px; justify-content: center; margin: 6px 0px 16px; }

.cd div { min-width: 58px; padding: 6px 4px 5px; border: 1px solid var(--gold); background: rgba(255, 249, 232, 0.816); border-radius: 4px; box-shadow: rgba(255, 255, 255, 0.533) 0px 0px 0px 2px inset; }

.cd b { display: block; font: 700 20px / 1.2 "Noto Sans Kannada", sans-serif; color: var(--maroon); }

.cd small { font: 600 10px "Noto Sans Kannada", sans-serif; color: var(--blue); }

.cdlabel { font-size: 11px; font-weight: 700; color: var(--pink); margin: 0px; }

.hosts { text-align: right; margin: 8px 0px 14px; }

.hosts .n { font-size: 16px; font-weight: 800; color: var(--blue); line-height: 1.9; }

.hosts .a { font-size: 13px; font-weight: 700; color: var(--maroon); line-height: 1.9; }

.hosts a { color: inherit; text-decoration: none; }

.bandhu { font-size: 12.5px; font-weight: 700; color: var(--ink); margin: 6px 0px 8px; }

.quote { font-family: "Tiro Kannada", "Noto Serif Kannada", serif; font-size: 19px; color: var(--pink); font-weight: 400; margin: 0px; line-height: 1.9; text-shadow: rgb(255, 255, 255) 0px 1px 0px; }

.cow { position: absolute; left: 20px; bottom: 24px; width: 84px; z-index: 5; mix-blend-mode: multiply; filter: saturate(1.05); }

.rv { opacity: 0; transform: translateY(14px); transition: opacity 0.8s, transform 0.8s; }

.rv.in { opacity: 1; transform: none; }

.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin: 20px 0px 0px; }

.btn { display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 46px; padding: 10px; border: 1px solid rgb(217, 189, 120); border-radius: 6px; background: rgba(255, 255, 255, 0.08); color: rgb(244, 228, 180); font: 600 13px "Noto Sans Kannada", sans-serif; text-decoration: none; transition: 0.2s; }

.btn:hover { background: rgba(255, 255, 255, 0.157); transform: translateY(-1px); }

.btn.primary { background: linear-gradient(rgb(226, 181, 80), rgb(184, 137, 58)); color: rgb(42, 26, 0); border-color: rgb(232, 196, 110); }

.btn.wide { grid-column: 1 / -1; }

.btn svg { width: 17px; height: 17px; }

.note { margin: 12px 0px 0px; color: rgb(244, 228, 180); font: 12px / 1.6 "Noto Sans Kannada", sans-serif; text-align: center; }

.below { text-align: center; color: rgb(216, 198, 140); font-size: 12.5px; margin-top: 22px; }

.below button { background: none; border: 0px; color: rgb(244, 228, 180); text-decoration: underline; font: 12px "Noto Sans Kannada", sans-serif; margin-top: 6px; }

.entrance { position: fixed; inset: 0px; z-index: 50; display: grid; place-items: center; overflow: hidden; background: rgb(27, 53, 36); }

.entrance[hidden] { display: none; }

.door { position: absolute; top: 0px; bottom: 0px; width: 50.2%; background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0px, rgba(255, 255, 255, 0.05) 2px, transparent 2px, transparent 26px), radial-gradient(circle, rgba(217, 168, 63, 0.333) 0px, rgba(217, 168, 63, 0.333) 40px, transparent 42px); transition: transform 1.3s cubic-bezier(0.7, 0, 0.2, 1); z-index: 2; box-shadow: rgba(0, 0, 0, 0.533) 0px 0px 40px; }

.door.l { left: 0px; border-right: 3px solid var(--gold); }

.door.r { right: 0px; border-left: 3px solid var(--gold); }

.entrance.open .door.l { transform: translateX(-101%); }

.entrance.open .door.r { transform: translateX(101%); }

.welcome { position: relative; z-index: 3; text-align: center; color: rgb(247, 230, 176); padding: 24px; transition: opacity 0.5s, transform 0.8s; }

.entrance.open .welcome { opacity: 0; transform: scale(1.15); }

.entrance.open { background: transparent; transition: background 1s 1s; }

.welcome .s { font: 600 11px "Noto Sans Kannada", sans-serif; letter-spacing: 3px; color: rgb(255, 217, 120); }

.welcome h2 { font-family: "Tiro Kannada", serif; font-weight: 400; font-size: 58px; margin: 8px 0px; color: rgb(255, 233, 168); text-shadow: rgba(0, 0, 0, 0.667) 0px 3px 14px; }

.welcome p { font-size: 15px; line-height: 1.9; margin: 0px 0px 6px; }

.welcome .d { font: 600 14px "Noto Sans Kannada", sans-serif; letter-spacing: 2px; margin: 12px 0px 22px; color: rgb(255, 217, 120); }

.open-btn { padding: 14px 30px; border-radius: 40px; border: 2px solid rgb(255, 217, 120); background: linear-gradient(rgb(233, 190, 90), rgb(184, 137, 58)); color: rgb(42, 26, 0); font-weight: 800; font-size: 16px; animation: 2s ease 0s infinite normal none running pulse; }

@keyframes pulse { 
  0% { box-shadow: rgba(255, 217, 120, 0.6) 0px 0px 0px 0px; }
  100% { box-shadow: transparent 0px 0px 0px 18px; }
}

.diya { font-size: 44px; animation: 1.4s ease 0s infinite alternate none running flick; }

@keyframes flick { 
  100% { transform: scale(1.1); filter: brightness(1.3); }
}

.modal { position: fixed; inset: 0px; z-index: 60; background: rgba(0, 0, 0, 0.867); display: grid; place-items: center; padding: 16px; overflow: auto; }

.modal[hidden], .toast[hidden], .note[hidden] { display: none; }

.modal img { max-width: 100%; max-height: 88vh; box-shadow: rgb(0, 0, 0) 0px 10px 60px; }

.close { position: fixed; top: 12px; right: 12px; padding: 8px 14px; border-radius: 6px; border: 0px; background: rgb(255, 255, 255); font-weight: 700; }

.toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 70; background: rgb(17, 17, 17); color: rgb(255, 255, 255); padding: 12px 18px; border-radius: 8px; font: 13px "Noto Sans Kannada", sans-serif; max-width: 90vw; text-align: center; }

.petal { position: fixed; top: -30px; width: 12px; height: 16px; border-radius: 70% 0px; background: rgb(255, 184, 28); opacity: 0.85; z-index: 40; pointer-events: none; animation: auto linear 0s infinite normal none running fall; }

@keyframes fall { 
  0% { transform: translate(0px, 0px) rotate(0deg); }
  100% { transform: translate(60px, 110vh) rotate(520deg); opacity: 0.2; }
}

@media (max-width: 400px) {
  .content { padding: 30px 20px 22px; }
  .leaf { width: 120px; height: 190px; }
  .panch { font-size: 12.5px; }
  .cow { width: 68px; }
}

@media (prefers-reduced-motion: reduce) {
  * { animation: auto ease 0s 1 normal none running none !important; transition: none !important; }
  .rv, .card { opacity: 1; transform: none; }
}

@media print {
  body { background: rgb(255, 255, 255); }
  .entrance, .actions, .below, .topline, .petal, .note, .toast { display: none !important; }
  main { padding: 0px; max-width: none; }
  .card { box-shadow: none; opacity: 1; transform: none; animation: auto ease 0s 1 normal none running none; }
  .rv { opacity: 1; transform: none; }
}
